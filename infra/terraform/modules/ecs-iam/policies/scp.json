{
    "Version": "2012-10-17",
    "Statement": [
        {
        "Sid": "ForgeServices",
        "Effect": "Deny",
        "Action": [
            "ecs:CreateService",
            "ecs:UpdateService",
            "ecs:DeleteService"
        ],
        "Resource": "arn:aws:ecs:us-east-1:241197444395:service/forge-ecs/forge-*",
        "Condition": {
            "ArnNotLike": {
            "aws:PrincipalArn": "arn:aws:iam::241197444395:role/forge-ecs-cloudformation-role"
            }
        }
        },
        {
            "Sid": "Scaling",
            "Effect": "Deny",
            "Action": [
                "application-autoscaling:RegisterScalableTarget",
                "application-autoscaling:DeregisterScalableTarget",
                "application-autoscaling:PutScalingPolicy",
                "application-autoscaling:DeleteScalingPolicy"
            ],
            "Resource": "*",
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": "arn:aws:iam::241197444395:role/forge-ecs-cloudformation-role"
                }
            }
        }
    ]
}