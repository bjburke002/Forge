{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Forge service forge-payments-dev",
  "Parameters": {
    "ALBDNSName": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Description": "DNS Name for the ALB",
      "Default": "/forge/ecs/alb-dns-name"
    },
    "ALBFullName": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Description": "Full ARN suffix of the ALB",
      "Default": "/forge/ecs/alb-full-name"
    },
    "ALBZoneId": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Description": "Route53 Zone ID for ECS ALB",
      "Default": "/forge/ecs/alb-zone-id"
    },
    "ActiveTargetGroup": {
      "Type": "String",
      "Description": "Target group that production currently forwards to",
      "Default": "primary",
      "AllowedValues": [
        "primary",
        "alternate"
      ]
    },
    "CanaryHookArn": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Description": "Canary Hook ARN",
      "Default": "/forge/ecs/canary-hook-arn"
    },
    "ClusterName": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Description": "ECS ClusterName",
      "Default": "/forge/ecs/cluster-name"
    },
    "ExecutionRoleArn": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Description": "ARN for the ECS Execution Role",
      "Default": "/forge/shared/ecs-task-execution-role-arn"
    },
    "HTTPSListenerArn": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Description": "ECS ALB HTTPS Listener ARN",
      "Default": "/forge/ecs/https-listener-arn"
    },
    "HookInvokeRoleArn": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Description": "The ARN of the Hook Invoke ARN used to invoke Lambda",
      "Default": "/forge/shared/ecs-hook-invoke-role-arn"
    },
    "HostedZoneId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::Route53::HostedZone::Id>",
      "Description": "Route53 Hosted Zone for forgeappservices.com",
      "Default": "/forge/shared/hosted-zone-id"
    },
    "InfrastructureRoleArn": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Description": "The ARN of the ECS Infrastructure Role",
      "Default": "/forge/shared/ecs-infrastructure-role-arn"
    },
    "PrivateSubnetIds": {
      "Type": "AWS::SSM::Parameter::Value<List<AWS::EC2::Subnet::Id>>",
      "Description": "List of IDs for the ECS private subnets",
      "Default": "/forge/ecs/private-subnet-ids"
    },
    "TaskSecurityGroupId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::SecurityGroup::Id>",
      "Description": "ID for the ECS Task Security Group",
      "Default": "/forge/ecs/task-security-group-id"
    },
    "TestListenerArn": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Description": "The ARN of the canary test listener",
      "Default": "/forge/ecs/test-listener-arn"
    },
    "VPCId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::VPC::Id>",
      "Description": "The VPC ID of the ECS VPC",
      "Default": "/forge/ecs/vpc-id"
    }
  },
  "Conditions": {
    "UseAlternateTargetGroup": {
      "Fn::Equals": [
        {
          "Ref": "ActiveTargetGroup"
        },
        "alternate"
      ]
    }
  },
  "Resources": {
    "AlternateTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {
          "Ref": "VPCId"
        },
        "HealthCheckPath": "/health/ready",
        "HealthCheckProtocol": "HTTP",
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "forge"
          },
          {
            "Key": "Backend",
            "Value": "ecs"
          },
          {
            "Key": "Service",
            "Value": "payments"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "Owner",
            "Value": "payments-team"
          }
        ]
      }
    },
    "ErrorRateAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "forge-payments-dev-5xx",
        "AlarmDescription": "Rolls back a deployment of forge-payments-dev on a high 5xx ratio",
        "ComparisonOperator": "GreaterThanThreshold",
        "Threshold": 5,
        "EvaluationPeriods": 3,
        "DatapointsToAlarm": 2,
        "TreatMissingData": "notBreaching",
        "Metrics": [
          {
            "Id": "e1",
            "MetricStat": {
              "Metric": {
                "Namespace": "AWS/ApplicationELB",
                "MetricName": "HTTPCode_Target_5XX_Count",
                "Dimensions": [
                  {
                    "Name": "LoadBalancer",
                    "Value": {
                      "Ref": "ALBFullName"
                    }
                  },
                  {
                    "Name": "TargetGroup",
                    "Value": {
                      "Fn::GetAtt": [
                        "TargetGroup",
                        "TargetGroupFullName"
                      ]
                    }
                  }
                ]
              },
              "Period": 60,
              "Stat": "Sum"
            },
            "ReturnData": false
          },
          {
            "Id": "e2",
            "MetricStat": {
              "Metric": {
                "Namespace": "AWS/ApplicationELB",
                "MetricName": "HTTPCode_Target_5XX_Count",
                "Dimensions": [
                  {
                    "Name": "LoadBalancer",
                    "Value": {
                      "Ref": "ALBFullName"
                    }
                  },
                  {
                    "Name": "TargetGroup",
                    "Value": {
                      "Fn::GetAtt": [
                        "AlternateTargetGroup",
                        "TargetGroupFullName"
                      ]
                    }
                  }
                ]
              },
              "Period": 60,
              "Stat": "Sum"
            },
            "ReturnData": false
          },
          {
            "Id": "r1",
            "MetricStat": {
              "Metric": {
                "Namespace": "AWS/ApplicationELB",
                "MetricName": "RequestCount",
                "Dimensions": [
                  {
                    "Name": "LoadBalancer",
                    "Value": {
                      "Ref": "ALBFullName"
                    }
                  },
                  {
                    "Name": "TargetGroup",
                    "Value": {
                      "Fn::GetAtt": [
                        "TargetGroup",
                        "TargetGroupFullName"
                      ]
                    }
                  }
                ]
              },
              "Period": 60,
              "Stat": "Sum"
            },
            "ReturnData": false
          },
          {
            "Id": "r2",
            "MetricStat": {
              "Metric": {
                "Namespace": "AWS/ApplicationELB",
                "MetricName": "RequestCount",
                "Dimensions": [
                  {
                    "Name": "LoadBalancer",
                    "Value": {
                      "Ref": "ALBFullName"
                    }
                  },
                  {
                    "Name": "TargetGroup",
                    "Value": {
                      "Fn::GetAtt": [
                        "AlternateTargetGroup",
                        "TargetGroupFullName"
                      ]
                    }
                  }
                ]
              },
              "Period": 60,
              "Stat": "Sum"
            },
            "ReturnData": false
          },
          {
            "Id": "errors",
            "Expression": "FILL(e1, 0) + FILL(e2, 0)",
            "ReturnData": false
          },
          {
            "Id": "requests",
            "Expression": "FILL(r1, 0) + FILL(r2, 0)",
            "ReturnData": false
          },
          {
            "Id": "ratio",
            "Expression": "IF(requests >= 20, 100 * errors / requests, 0)",
            "Label": "5xx %",
            "ReturnData": true
          }
        ]
      }
    },
    "ListenerRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HTTPSListenerArn"
        },
        "Priority": 28944,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "payments-dev.forgeappservices.com"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Fn::If": [
                "UseAlternateTargetGroup",
                {
                  "Ref": "AlternateTargetGroup"
                },
                {
                  "Ref": "TargetGroup"
                }
              ]
            }
          }
        ]
      }
    },
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "forge-payments-dev",
        "RetentionInDays": 7,
        "Tags": [
          {
            "Key": "Project",
            "Value": "forge"
          },
          {
            "Key": "Backend",
            "Value": "ecs"
          },
          {
            "Key": "Service",
            "Value": "payments"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "Owner",
            "Value": "payments-team"
          }
        ]
      }
    },
    "RecordSet": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": "payments-dev.forgeappservices.com",
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Ref": "ALBDNSName"
          },
          "HostedZoneId": {
            "Ref": "ALBZoneId"
          },
          "EvaluateTargetHealth": false
        }
      }
    },
    "ScalableTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "ServiceNamespace": "ecs",
        "ScalableDimension": "ecs:service:DesiredCount",
        "ResourceId": {
          "Fn::Sub": "service/${ClusterName}/forge-payments-dev"
        },
        "MinCapacity": 2,
        "MaxCapacity": 5
      },
      "DependsOn": [
        "Service"
      ]
    },
    "ScalingPolicy": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": "forge-payments-dev-cpu",
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "ScalableTarget"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 75,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          }
        }
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": "forge-payments-dev",
        "Cluster": {
          "Ref": "ClusterName"
        },
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        },
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE_SPOT",
            "Weight": 1
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": {
              "Ref": "PrivateSubnetIds"
            },
            "SecurityGroups": [
              {
                "Ref": "TaskSecurityGroupId"
              }
            ],
            "AssignPublicIp": "DISABLED"
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "payments",
            "ContainerPort": 8080,
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            },
            "AdvancedConfiguration": {
              "AlternateTargetGroupArn": {
                "Ref": "AlternateTargetGroup"
              },
              "ProductionListenerRule": {
                "Ref": "ListenerRule"
              },
              "TestListenerRule": {
                "Ref": "TestListenerRule"
              },
              "RoleArn": {
                "Ref": "InfrastructureRoleArn"
              }
            }
          }
        ],
        "HealthCheckGracePeriodSeconds": 60,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "Strategy": "CANARY",
          "BakeTimeInMinutes": 1,
          "CanaryConfiguration": {
            "CanaryPercent": 10,
            "CanaryBakeTimeInMinutes": 1
          },
          "LifecycleHooks": [
            {
              "HookTargetArn": {
                "Ref": "CanaryHookArn"
              },
              "RoleArn": {
                "Ref": "HookInvokeRoleArn"
              },
              "LifecycleStages": [
                "POST_TEST_TRAFFIC_SHIFT"
              ],
              "HookDetails": {
                "url": "https://payments-dev.forgeappservices.com:8443/health/ready"
              }
            }
          ],
          "Alarms": {
            "AlarmNames": [
              {
                "Ref": "ErrorRateAlarm"
              }
            ],
            "Enable": true,
            "Rollback": true
          }
        },
        "PropagateTags": "SERVICE",
        "Tags": [
          {
            "Key": "Project",
            "Value": "forge"
          },
          {
            "Key": "Backend",
            "Value": "ecs"
          },
          {
            "Key": "Service",
            "Value": "payments"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "Owner",
            "Value": "payments-team"
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {
          "Ref": "VPCId"
        },
        "HealthCheckPath": "/health/ready",
        "HealthCheckProtocol": "HTTP",
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "forge"
          },
          {
            "Key": "Backend",
            "Value": "ecs"
          },
          {
            "Key": "Service",
            "Value": "payments"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "Owner",
            "Value": "payments-team"
          }
        ]
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "forge-payments-dev",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Ref": "ExecutionRoleArn"
        },
        "ContainerDefinitions": [
          {
            "Name": "payments",
            "Image": "241197444395.dkr.ecr.us-east-1.amazonaws.com/forge/payments-api:abc123",
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "ReadonlyRootFilesystem": true,
            "User": "65532",
            "Privileged": false,
            "MountPoints": [
              {
                "SourceVolume": "tmp",
                "ContainerPath": "/tmp",
                "ReadOnly": false
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "payments"
              }
            }
          }
        ],
        "Volumes": [
          {
            "Name": "tmp"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "forge"
          },
          {
            "Key": "Backend",
            "Value": "ecs"
          },
          {
            "Key": "Service",
            "Value": "payments"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "Owner",
            "Value": "payments-team"
          }
        ]
      }
    },
    "TestListenerRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "TestListenerArn"
        },
        "Priority": 28944,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "payments-dev.forgeappservices.com"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Fn::If": [
                "UseAlternateTargetGroup",
                {
                  "Ref": "AlternateTargetGroup"
                },
                {
                  "Ref": "TargetGroup"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "AlternateTargetGroupArn": {
      "Description": "ARN of the Canary target group",
      "Value": {
        "Ref": "AlternateTargetGroup"
      }
    },
    "ListenerRuleArn": {
      "Description": "ARN of the Listener Rule",
      "Value": {
        "Ref": "ListenerRule"
      }
    },
    "URL": {
      "Description": "ForgeService Domain name",
      "Value": "https://payments-dev.forgeappservices.com/"
    }
  }
}
